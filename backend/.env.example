# App
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent (defaults: dev=debug, prod=info, test=silent)
LOG_LEVEL=
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Local: `npm run db:up` starts Postgres from ../docker-compose.yml on port 5435.
# Hosted (Render/Neon/...): paste the external URL and append ?sslmode=require
DATABASE_URL=postgresql://slack_agent:slack_agent@localhost:5435/slack_agent?schema=public
DATABASE_POOL_MAX=10

# Slack (Socket Mode). Leave empty to run without Slack: events can then be simulated with
# POST /api/dev/slack/events. Required in production. Setup guide: ../docs/slack-app-setup.md
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# Comma-separated channel IDs whose member_joined_channel events trigger the agent (empty = team_join only)
SLACK_WATCH_CHANNEL_IDS=
# Private channel where analysis reports are posted (used from the pipeline step)
SLACK_REPORT_CHANNEL_ID=
