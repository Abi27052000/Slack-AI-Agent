# App
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent (defaults: dev=debug, prod=info, test=silent)
LOG_LEVEL=
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Local: `npm run db:up` starts Postgres from ../docker-compose.yml on port 5435.
# Hosted (Render/Neon/...): paste the external URL and append ?sslmode=require
DATABASE_URL=postgresql://slack_agent:slack_agent@localhost:5435/slack_agent?schema=public
DATABASE_POOL_MAX=10

# Slack (Socket Mode). Leave empty to run without Slack: events can then be simulated with
# POST /api/dev/slack/events. Required in production. Setup guide: ../docs/slack-app-setup.md
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# Comma-separated channel IDs whose member_joined_channel events trigger the agent (empty = team_join only)
SLACK_WATCH_CHANNEL_IDS=
# Private channel where analysis reports are posted (invite the bot to it). Empty = store only, no posts
SLACK_REPORT_CHANNEL_ID=

# Research
# Optional GitHub token (no scopes needed): raises the API limit from 60 to 5,000 requests/hour.
# Create one at https://github.com/settings/personal-access-tokens (fine-grained, public repos read-only).
GITHUB_TOKEN=
# Time budget per research provider in ms (a slow provider is dropped, never blocks the analysis)
RESEARCH_TIMEOUT_MS=8000

# Gemini (member-fit analysis). Free key: https://aistudio.google.com/apikey
# Leave empty to run without it (analyses are stored as fallbacks needing manual review). Required in production.
GEMINI_API_KEY=
# Stable model ID, see https://ai.google.dev/gemini-api/docs/models (checked at startup)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3

# Company context for the analysis prompt (the better these are, the better the scores)
COMPANY_NAME=Your Company
COMPANY_PRODUCT=Your Product
COMPANY_DESCRIPTION=
# Who is a great fit, e.g. "Engineering leaders at 50-500 person B2B SaaS companies"
IDEAL_CUSTOMER_PROFILE=

# Pipeline
# Don't re-analyse a member analysed within this many days (0 = only skip while one is running)
REANALYZE_COOLDOWN_DAYS=30
# How many members are researched/analysed at the same time
PIPELINE_CONCURRENCY=2
# Admin dashboard URL; when set, Slack reports link to the analysis (e.g. http://localhost:5173)
DASHBOARD_URL=
