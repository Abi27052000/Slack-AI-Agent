# App
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent (defaults: dev=debug, prod=info, test=silent)
LOG_LEVEL=
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Local: `npm run db:up` starts Postgres from ../docker-compose.yml on port 5435.
# Hosted (Render/Neon/...): paste the external URL and append ?sslmode=require
DATABASE_URL=postgresql://slack_agent:slack_agent@localhost:5435/slack_agent?schema=public
DATABASE_POOL_MAX=10
